generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId      Int      @id @default(autoincrement())
  name        String
  lastName    String
  email       String    @db.Citext @unique
  password    String
  phone       String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blacklistedTokens     BlacklistedToken[]
  responses             RequestResponse[] @relation("UserResponses")
  requests              Request[]
  userUserTypes         UserUserType[]
  passwordResetTokens   PasswordResetToken[]
  emergencies           Emergency[]

  @@index([name])
  @@index([lastName])
}

model UserType {
  userTypeId   Int      @id @default(autoincrement())
  name         String   @unique

  userUserTypes UserUserType[]
}

model UserUserType {
  userUserTypeId Int      @id @default(autoincrement())
  userId         Int
  userTypeId     Int

  user     User     @relation(fields: [userId], references: [userId])
  userType UserType @relation(fields: [userTypeId], references: [userTypeId])

  @@unique([userId, userTypeId])
  @@index([userTypeId])
}

enum ProjectStatus {
  active
  inactive
  completed
}

model Project {
  projectId   Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  description String   @db.Text @default("No description provided.")
  status      ProjectStatus @default(active)
  location    String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests        Request[]
  emergencies     Emergency[]
  purchaseOrders  PurchaseOrder[]
  pettyCashes     PettyCash[]
  serviceSales    ServiceSale[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
}

enum ElementType {
  epp
  operative
}

model Element {
  elementId    Int      @id @default(autoincrement())
  name         String
  description  String   @db.Text @default("No description provided.")
  type         ElementType
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  elementRequests ElementRequest[]

  @@index([type])
}

enum RequestStatus {
  draft
  inProgress
  reviewed
  approved
  rejected
  addressed
  completed
}

enum RequestType {
  epp
  operative
  eppAndOperative
}

model Request {
  requestId        Int            @id @default(autoincrement())
  deliveryDueDate  DateTime
  status           RequestStatus  @default(draft)
  description      String         @db.Text @default("No description provided.")
  userId           Int
  projectId        Int
  type             RequestType
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project          Project @relation(fields: [projectId], references: [projectId])
  user             User    @relation(fields: [userId], references: [userId])
  elementRequests  ElementRequest[]
  requestWorkers   RequestWorker[]
  responses        RequestResponse[]

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([userId])
  @@index([deliveryDueDate])
  @@index([createdAt])
}

model RequestWorker {
  requestWorkerId Int       @id @default(autoincrement())
  requestId       Int
  fullName        String
  shoeSize        String
  pantsSize       String
  shirtSize       String
  workerId        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [requestId])
  worker  Worker? @relation(fields: [workerId], references: [workerId])

  @@unique([requestId, workerId])
  @@index([requestId])
  @@index([workerId])
}

model ElementRequest {
  elementRequestId   Int     @id @default(autoincrement())
  quantityRequested  Int
  unit               String
  elementId          Int
  requestId          Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  element  Element  @relation(fields: [elementId], references: [elementId])
  request  Request  @relation(fields: [requestId], references: [requestId])
  elementRequestResponses ElementRequestResponse[]

  @@unique([requestId, elementId])
  @@index([elementId])
  @@index([requestId])
}

model RequestResponse {
  requestResponseId Int      @id @default(autoincrement())
  responderUserId   Int
  requestId         Int
  description       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request   Request @relation(fields: [requestId], references: [requestId])
  responder User    @relation("UserResponses", fields: [responderUserId], references: [userId])
  elementRequestResponses ElementRequestResponse[]

  @@index([responderUserId])
  @@index([requestId])
}

model ElementRequestResponse {
  elementRequestResponseId Int     @id @default(autoincrement())
  elementRequestId         Int
  requestResponseId        Int
  quantityAccepted          Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  elementRequest  ElementRequest @relation(fields: [elementRequestId], references: [elementRequestId])
  requestResponse RequestResponse @relation(fields: [requestResponseId], references: [requestResponseId])

  @@index([elementRequestId])
  @@index([requestResponseId])
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
}

enum EmergencyStatus {
  pending
  addressed
  rejected
}

model Emergency {
  emergencyId Int      @id @default(autoincrement())
  image       String
  title       String
  description String  @db.Text
  userId      Int
  projectId   Int
  status      EmergencyStatus @default(pending)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId])
  project Project @relation(fields: [projectId], references: [projectId])

  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model Worker {
  workerId      Int      @id @default(autoincrement())
  fullName      String
  dni           String   @db.VarChar(8) @unique
  phone         String
  address       String   @default("No address provided.")
  workerGroupId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workerGroup    WorkerGroup @relation(fields: [workerGroupId], references: [workerGroupId])
  requestWorkers RequestWorker[]

  @@index([dni])
  @@index([workerGroupId])
}

model WorkerGroup {
  workerGroupId  Int      @id @default(autoincrement())
  name           String
  description    String?  @db.Text
  parentGroupId  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentGroup WorkerGroup? @relation("WorkerGroupToWorkerGroup", fields: [parentGroupId], references: [workerGroupId])
  subGroups   WorkerGroup[] @relation("WorkerGroupToWorkerGroup")
  workers     Worker[]

  @@unique([parentGroupId, name])
  @@index([parentGroupId])
  @@index([name])
}

model Supplier {
  supplierId     Int      @id @default(autoincrement())
  name           String
  contactName    String
  phone          String
  email          String   @db.Citext @unique
  address        String
  ruc            String   @unique
  accountNumber  String
  bank           String
  currency       Currency @default(PEN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([createdAt])
}

model CategoryResource {
  categoryResourceId Int      @id @default(autoincrement())
  name               String
  description        String?  @db.Text
  parentCategoryId   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parentCategory CategoryResource? @relation("CategoryResourceToCategoryResource", fields: [parentCategoryId], references: [categoryResourceId])
  subCategories  CategoryResource[] @relation("CategoryResourceToCategoryResource")
  resources      Resource[]

  @@unique([parentCategoryId, name])
  @@index([parentCategoryId])
  @@index([name])
}

model Resource {
  resourceId         Int      @id @default(autoincrement())
  name               String
  description        String?  @db.Text
  categoryResourceId Int
  unit               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  categoryResource CategoryResource @relation(fields: [categoryResourceId], references: [categoryResourceId])
  resourcePurchaseOrders ResourcePurchaseOrder[]

  @@unique([categoryResourceId, name])
  @@index([categoryResourceId])
  @@index([name])
}

enum PurchaseOrderType {
  materials
  services
}

enum Currency {
  USD
  EUR
  PEN
}

enum PaymentMethod {
  deposit
  transfer
}

enum PurchaseOrderStatus {
  pending
  authorized
  delivered
  cancelled
}

model PurchaseOrder {
  purchaseOrderId         Int                 @id @default(autoincrement())
  code                    String              @unique
  issuedAt                DateTime
  deliveryLocation        String
  destination             String
  paymentConditions       String
  generalConditions       String              @db.Text @default("No general conditions specified.")
  qualityConditions       String              @db.Text @default("No quality conditions specified.")
  paymentMethod           PaymentMethod
  saleAmount              Decimal             @db.Decimal(18,2)
  purchaseAmount          Decimal             @db.Decimal(18,2)
  status                  PurchaseOrderStatus @default(pending)
  carePerson              String
  dniCarePerson           String              @db.VarChar(8)
  observations            String              @db.Text @default("No observations provided.")
  projectId               Int
  supplierId              Int
  logisticsManager        String              @default("Morayma Lloja Fernandez")
  authorizer              String              @default("Henrry Gayoso Valdera")
  administrativeManager   String              @default("Angi Gonzales Cotrina")
  quotation               String              @default("No quotation provided.")
  purchaseOrderType       PurchaseOrderType   @default(materials)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  project   Project   @relation(fields: [projectId], references: [projectId])
  supplier  Supplier  @relation(fields: [supplierId], references: [supplierId])
  resources ResourcePurchaseOrder[]

  @@index([status])
  @@index([projectId])
  @@index([supplierId])
  @@index([createdAt])
}

model ResourcePurchaseOrder {
  resourcePurchaseOrderId Int     @id @default(autoincrement())
  purchaseOrderId         Int
  resourceId              Int
  quantity                Decimal @db.Decimal(18,2)
  unitSalesPrice          Decimal @db.Decimal(18,2)
  unitPurchasePrice       Decimal @db.Decimal(18,2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resource       Resource       @relation(fields: [resourceId], references: [resourceId])
  purchaseOrder  PurchaseOrder  @relation(fields: [purchaseOrderId], references: [purchaseOrderId])

  @@unique([purchaseOrderId, resourceId])
  @@index([resourceId])
  @@index([purchaseOrderId])
}

model PettyCash {
  pettyCashId   Int      @id @default(autoincrement())
  projectId     Int
  resourceName  String
  amount        Decimal  @db.Decimal(18,2)
  description   String   @db.Text @default("No description provided")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
  @@index([createdAt])
}

model ServiceSale {
  serviceSaleId Int      @id @default(autoincrement())
  projectId     Int
  serviceName   String
  amount        Decimal  @db.Decimal(18,2)
  description   String   @db.Text @default("No description provided")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
  @@index([createdAt])
}

model BlacklistedToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expiresAt  DateTime
  userId     Int?

  user User? @relation(fields: [userId], references: [userId])
}
