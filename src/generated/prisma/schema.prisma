generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    Int       @id @default(autoincrement())
  name      String
  lastName  String
  email     String    @unique @db.Citext
  password  String
  phone     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  blacklistedTokens   BlacklistedToken[]
  responses           RequestResponse[]    @relation("UserResponses")
  requests            Request[]
  userUserTypes       UserUserType[]
  passwordResetTokens PasswordResetToken[]
  emergencies         Emergency[]

  @@index([name])
  @@index([lastName])
  @@index([deletedAt])
}

model UserType {
  userTypeId Int    @id @default(autoincrement())
  name       String @unique

  userUserTypes UserUserType[]
}

model UserUserType {
  userUserTypeId Int @id @default(autoincrement())
  userId         Int
  userTypeId     Int

  user     User     @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  userType UserType @relation(fields: [userTypeId], references: [userTypeId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, userTypeId])
  @@index([userTypeId])
}

enum ProjectStatus {
  active
  inactive
  completed
}

model Project {
  projectId   Int           @id @default(autoincrement())
  name        String
  code        String        @unique
  description String        @default("Sin descripción.") @db.Text
  status      ProjectStatus @default(active)
  location    String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  requests       Request[]
  emergencies    Emergency[]
  purchaseOrders PurchaseOrder[]
  pettyCashes    PettyCash[]
  serviceSales   ServiceSale[]
  attendances    Attendance[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([deletedAt])
}

enum ElementType {
  epp
  operative
}

model Element {
  elementId   Int         @id @default(autoincrement())
  name        String
  description String      @default("Sin descripción.") @db.Text
  type        ElementType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  elementRequests ElementRequest[]

  @@index([type])
  @@index([deletedAt])
}

enum RequestStatus {
  draft
  inProgress
  reviewed
  approved
  rejected
  addressed
  completed
}

enum RequestType {
  epp
  operative
  eppAndOperative
}

model Request {
  requestId       Int           @id @default(autoincrement())
  deliveryDueDate DateTime
  status          RequestStatus @default(draft)
  description     String        @default("Sin descripción.") @db.Text
  userId          Int
  projectId       Int
  type            RequestType
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project           @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)
  user            User              @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  elementRequests ElementRequest[]
  requestWorkers  RequestWorker[]
  responses       RequestResponse[]

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([userId])
  @@index([deliveryDueDate])
  @@index([createdAt])
}

model RequestWorker {
  requestWorkerId Int      @id @default(autoincrement())
  requestId       Int
  shoeSize        String?
  pantsSize       String?
  shirtSize       String?
  workerId        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [workerId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([requestId, workerId])
  @@index([requestId])
  @@index([workerId])
}

model ElementRequest {
  elementRequestId  Int      @id @default(autoincrement())
  quantityRequested Int
  unit              String
  elementId         Int
  requestId         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  element                 Element                  @relation(fields: [elementId], references: [elementId], onDelete: Restrict, onUpdate: Cascade)
  request                 Request                  @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: Cascade)
  elementRequestResponses ElementRequestResponse[]

  @@unique([requestId, elementId])
  @@index([elementId])
  @@index([requestId])
}

model RequestResponse {
  requestResponseId Int      @id @default(autoincrement())
  responderUserId   Int
  requestId         Int
  description       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request                 Request                  @relation(fields: [requestId], references: [requestId], onDelete: Cascade, onUpdate: Cascade)
  responder               User                     @relation("UserResponses", fields: [responderUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  elementRequestResponses ElementRequestResponse[]

  @@index([responderUserId])
  @@index([requestId])
}

model ElementRequestResponse {
  elementRequestResponseId Int      @id @default(autoincrement())
  elementRequestId         Int
  requestResponseId        Int
  quantityAccepted         Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  elementRequest  ElementRequest  @relation(fields: [elementRequestId], references: [elementRequestId], onDelete: Cascade, onUpdate: Cascade)
  requestResponse RequestResponse @relation(fields: [requestResponseId], references: [requestResponseId], onDelete: Cascade, onUpdate: Cascade)

  @@index([elementRequestId])
  @@index([requestResponseId])
}

enum EmergencyStatus {
  pending
  addressed
  rejected
}

model Emergency {
  emergencyId Int             @id @default(autoincrement())
  image       String
  title       String
  description String          @db.Text
  userId      Int
  projectId   Int
  status      EmergencyStatus @default(pending)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)

  @@index([status])
  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model Worker {
  workerId      Int        @id @default(autoincrement())
  fullName      String
  dni           String     @unique @db.VarChar(8)
  phone         String?    @unique
  personalEmail String?    @unique @db.Citext
  address       String?    @default("No address provided.")
  birthDate     DateTime?
  workerType    WorkerType @default(unspecified)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  requestWorkers RequestWorker[]
  weeklyWages    WeeklyWage[]
  attendances    Attendance[]
  dailyWages     DailyWage[]

  @@index([dni])
  @@index([deletedAt])
}

enum WorkerType {
  laborer
  technician
  engineer
  administrator
  manager
  unspecified
}

model Supplier {
  supplierId    Int       @id @default(autoincrement())
  name          String    @unique
  contactName   String
  phone         String
  email         String?   @unique @db.Citext
  address       String?
  ruc           String    @unique
  accountNumber String
  bank          String
  currency      Currency  @default(PEN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([createdAt])
  @@index([deletedAt])
}

model CategoryResource {
  categoryResourceId Int      @id @default(autoincrement())
  name               String
  description        String?  @db.Text
  parentCategoryId   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parentCategory CategoryResource?  @relation("CategoryResourceToCategoryResource", fields: [parentCategoryId], references: [categoryResourceId], onDelete: Restrict, onUpdate: Cascade)
  subCategories  CategoryResource[] @relation("CategoryResourceToCategoryResource")
  resources      Resource[]

  @@unique([parentCategoryId, name])
  @@index([parentCategoryId])
  @@index([name])
}

model Resource {
  resourceId         Int       @id @default(autoincrement())
  name               String
  description        String?   @db.Text
  categoryResourceId Int
  unit               String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  categoryResource       CategoryResource        @relation(fields: [categoryResourceId], references: [categoryResourceId], onDelete: Restrict, onUpdate: Cascade)
  resourcePurchaseOrders ResourcePurchaseOrder[]

  @@unique([categoryResourceId, name])
  @@index([categoryResourceId])
  @@index([name])
  @@index([deletedAt])
}

enum PurchaseOrderType {
  materials
  services
}

enum Currency {
  USD
  EUR
  PEN
}

enum PaymentMethod {
  deposit
  transfer
}

enum PurchaseOrderStatus {
  pending
  authorized
  delivered
  cancelled
}

model PurchaseOrder {
  purchaseOrderId       Int                 @id @default(autoincrement())
  code                  String              @unique
  deliveryLocation      String
  destination           String
  paymentConditions     String
  generalConditions     String?             @default("No general conditions specified.") @db.Text
  qualityConditions     String?             @default("No quality conditions specified.") @db.Text
  paymentMethod         PaymentMethod
  saleAmount            Decimal             @db.Decimal(18, 2)
  purchaseAmount        Decimal             @db.Decimal(18, 2)
  status                PurchaseOrderStatus @default(pending)
  carePerson            String
  dniCarePerson         String              @db.VarChar(8)
  observations          String              @default("No observations provided.") @db.Text
  projectId             Int
  supplierId            Int
  logisticsManager      String?             @default("Morayma Lloja Fernandez")
  authorizer            String?             @default("Henrry Gayoso Valdera")
  administrativeManager String?             @default("Angi Gonzales Cotrina")
  quotation             String              @default("No quotation provided.")
  purchaseOrderType     PurchaseOrderType   @default(materials)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  project   Project                 @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)
  supplier  Supplier                @relation(fields: [supplierId], references: [supplierId], onDelete: Restrict, onUpdate: Cascade)
  resources ResourcePurchaseOrder[]

  @@index([status])
  @@index([projectId])
  @@index([supplierId])
  @@index([createdAt])
}

model ResourcePurchaseOrder {
  resourcePurchaseOrderId Int      @id @default(autoincrement())
  purchaseOrderId         Int
  resourceId              Int
  quantity                Decimal  @db.Decimal(18, 2)
  unitSalesPrice          Decimal  @db.Decimal(18, 2)
  unitPurchasePrice       Decimal  @db.Decimal(18, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resource      Resource      @relation(fields: [resourceId], references: [resourceId], onDelete: Restrict, onUpdate: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([purchaseOrderId, resourceId])
  @@index([resourceId])
  @@index([purchaseOrderId])
}

enum PettyCashType {
  meals
  fuel
  transport
  supplies
  safety_equipment
  services
  other
}

model PettyCash {
  pettyCashId   Int           @id @default(autoincrement())
  projectId     Int
  amount        Decimal       @db.Decimal(18, 2)
  description   String        @default("Sin descripción") @db.Text
  expenseDate   DateTime      @default(now())
  expenseType   PettyCashType @default(other)
  invoiceNumber String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@index([expenseDate])
}

model ServiceSale {
  serviceSaleId Int      @id @default(autoincrement())
  projectId     Int
  serviceName   String
  amount        Decimal  @db.Decimal(18, 2)
  description   String   @default("Sin descripción") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [userId], onDelete: SetNull, onUpdate: Cascade)

  @@index([expiresAt])
}

model Week {
  weekId    Int      @id @default(autoincrement())
  startDate DateTime @unique
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyWages    WeeklyWage[]
  attendances    Attendance[]
  dailyWagesFrom DailyWage[]

  @@index([startDate])
  @@index([endDate])
}

model DailyWage {
  dailyWageId Int     @id @default(autoincrement())
  workerId    Int
  amount      Decimal @db.Decimal(18, 2)

  // NUEVO: vigencia desde una semana
  validFromWeekId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  worker        Worker @relation(fields: [workerId], references: [workerId], onDelete: Restrict, onUpdate: Cascade)
  validFromWeek Week   @relation(fields: [validFromWeekId], references: [weekId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workerId, validFromWeekId])
  @@index([workerId])
  @@index([validFromWeekId])
}

model WeeklyWage {
  weeklyWageId Int      @id @default(autoincrement())
  workerId     Int
  weekId       Int
  totalAmount  Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [workerId], onDelete: Restrict, onUpdate: Cascade)
  week   Week   @relation(fields: [weekId], references: [weekId], onDelete: Cascade, onUpdate: Cascade)
}

model Attendance {
  attendanceId Int      @id @default(autoincrement())
  workerId     Int
  projectId    Int
  date         DateTime @db.Date
  weekId       Int
  createdAt    DateTime @default(now())

  worker  Worker  @relation(fields: [workerId], references: [workerId], onDelete: Restrict, onUpdate: Cascade)
  project Project @relation(fields: [projectId], references: [projectId], onDelete: Restrict, onUpdate: Cascade)
  week    Week    @relation(fields: [weekId], references: [weekId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workerId, date])
  @@index([workerId])
  @@index([projectId])
}
